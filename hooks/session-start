#!/usr/bin/env bash
# SessionStart hook for trading-bot-skills plugin

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read using-trading-bot-skills content
using_skills_content=$(cat "${PLUGIN_ROOT}/skills/using-trading-bot-skills/SKILL.md" 2>&1 || echo "Error reading using-trading-bot-skills skill")

# Escape string for JSON embedding using bash parameter substitution.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_skills_escaped=$(escape_for_json "$using_skills_content")
session_context="<EXTREMELY_IMPORTANT>\nYou have Trading Bot engineering skills.\n\nYou are building reliable day trading systems. Every skill encodes a lesson from real production trading bot failures. For trading domain knowledge, invoke the trading-bot-skills:trading-bot-architecture skill.\n\n**Below is the full content of your 'trading-bot-skills:using-trading-bot-skills' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**\n\n${using_skills_escaped}\n</EXTREMELY_IMPORTANT>"

# Output context injection as JSON for Claude Code
printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"

exit 0
